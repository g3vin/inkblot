{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // The suites, parity cases and stubs in tests/ are loaded by name, and
  // showcase/ and scripts/ run from the command line, so each file there is an entry.
  // src/ui and src/bridge are entries too: their index lists the whole design system and
  // protocol, used or not, so a primitive is found in one place.
  "entry": [
    "src/ui/index.js",
    "src/bridge/index.ts",
    "tests/unit/*.mjs",
    "tests/parity/**/*.mjs",
    "tests/layout/*.{mjs,jsx}",
    "showcase/*.mjs",
    "scripts/**/*.mjs"
  ],
  "project": ["src/**/*.{js,jsx,ts,tsx}", "tests/**/*.{mjs,jsx}", "showcase/**/*.{js,mjs}", "scripts/**/*.mjs"],
  // A type that appears in the same file's exported signatures stays exported, so a
  // caller can name what it is handed.
  "ignoreExportsUsedInFile": { "interface": true, "type": true },
  "ignore": [
    // Generated by `npm run types`.
    "src/types/inkblot-core.ts",
    // Read as text and injected into the page (showcase/session.mjs).
    "showcase/tauri-mock.js",
    // Where the design review's prototypes plug in (docs/design-review); empty until then.
    "src/ui/variants.js"
  ]
}
