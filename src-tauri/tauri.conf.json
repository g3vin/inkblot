{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Inkblot",
  "version": "0.1.0",
  "identifier": "com.inkblot.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run download:model && npm run download:rhyme && npm run dev",
    "beforeBuildCommand": "npm run download:model && npm run download:rhyme && npm run build"
  },
  
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Inkblot",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "assets/pos_context_tagger.onnx",
      "assets/pos_context_meta.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}


