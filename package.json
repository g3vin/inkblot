    "test:layout": "node tests/layout/run.mjs",
    "lint": "eslint .",
    "lint:design": "node scripts/lint-design.mjs",
    "typecheck": "tsc --noEmit",
    "parity": "node --experimental-loader ./tests/unit/loader.mjs tests/parity/run.mjs",
    "types": "./scripts/generate-types.sh",
    "types:check": "./scripts/generate-types.sh --check",
    "preview": "vite preview"
  },
