  "unreachable": [
    { "what": "Native menus (context menus, the menu bar, », Alignment, New…)", "why": "Drawn by the OS, not the page. The capture saves each one's items as <surface>-menu.json instead; their look is the system's." },
    { "what": "Confirmations: Delete note, Delete note branch, delete a reference, cover or typeset version, restore a typeset, Move project errors", "why": "They use the native dialog plugin (confirm/message) or window.confirm, which the OS draws." },
    { "what": "Print and export (Print document…, Export as …)", "why": "They hand off to the system print panel and save dialog." },
    { "what": "Detached document windows (Open in new window, a tab dragged out)", "why": "They need a second Tauri window." },
    { "what": "Dictation, read aloud speaking, synonyms and rhymes in the Workbench", "why": "They need the on-device models and the Rust side." },
    { "what": "Pinterest boards on a canvas, link previews, satellite pictures and online map tiles", "why": "They fetch from the network, which the capture blocks so runs stay comparable." },
    { "what": "Typeset's page pickers (chapter number, ornament, opening, scene break, running head) and the citation editor", "why": "In the mock the chapter head measures at 0,0, so its pickers open off-screen; the sample project has no chapter-opening typography or scene breaks; the margin handles show only for a focused page section; and a citation needs a reference, which the Rust side adds." },
    { "what": "Trackpad swiping between sidebar panels, drag ghosts (tabs, files, notes, clipboard), the traffic lights", "why": "They need native gestures, a live drag, or the macOS window." }
  ]
}
