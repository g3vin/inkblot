# Models download at runtime into the app data directory; none belong in the repo.
*.onnx
*.onnx.data
*.onnx.tmp

# Native builds (the iOS framework and its Xcode project's per-user state)
native/build/
xcuserdata/

# Node / Vite
node_modules/
dist/
dist-ssr/
/.cache
*.local

# Logs
logs
*.log
npm-debug.log*

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.sw?

# Claude Code local settings and agent worktrees
.claude/settings.local.json
.claude/worktrees/

# Coverage output
*.profraw

# Showcase captures (showcase/capture.mjs): built by the release workflow, never committed
showcase/out/
showcase/.dist/
showcase/.tmp/

# Design review screenshots (reproducible from the sha in docs/design-review/state.md)
design-review/out/

# Local research notes, kept out of the repo and out of code search
/reports/
/research_notes/
